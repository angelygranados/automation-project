{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium --project=firefox",
    "test:smoke": "playwright test --grep @smoke",
    "test:security": "playwright test --grep @security",
    "test:headed": "playwright test --project=chromium --headed",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "playwright show-report"
  },
  "author": "",
  "license": "MIT",
  "description": "Playwright + TypeScript framework: API and E2E tests, Allure reporting, GitHub Actions CI, OWASP ZAP scan and Docker.",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.15.0",
    "allure-playwright": "^3.15.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
